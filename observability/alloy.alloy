local.file_match "opspilot_logs" {
  path_targets = [
    {
      "__path__" = "/var/log/opspilot/opspilot.log",
      "job" = "opspilot",
    },
  ]
}

loki.source.file "opspilot_logs" {
  targets    = local.file_match.opspilot_logs.targets
  forward_to = [loki.write.local.receiver]
}

loki.write "local" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
